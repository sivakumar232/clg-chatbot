# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ── Groq LLM Inference (Multi-Key Rotation Supported) ──────────────────────────
# Comma-separated list of Groq API keys or a single key
GROQ_API_KEYS=gsk_your_groq_api_key_1,gsk_your_groq_api_key_2
GROQ_API_KEY=gsk_your_primary_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# ── Google Gemini (Fallback & Multimodal) ──────────────────────────────────────
# Comma-separated list of Gemini API keys or a single key
GEMINI_API_KEYS=AIzaSy_your_gemini_key_1,AIzaSy_your_gemini_key_2
GEMINI_API_KEY=AIzaSy_your_primary_gemini_key
GEMINI_MODEL=gemini-3.6-flash

# ── Qdrant Cloud Vector Database ──────────────────────────────────────────────
QDRANT_CLUSTER_ENDPOINT=https://your-qdrant-cluster-url.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=srkr_knowledge_base

# ── Jina AI (Embeddings & Reranker) ───────────────────────────────────────────
# Comma-separated list of Jina API keys or a single key
JINA_API_KEYS=jina_your_api_key_1,jina_your_api_key_2
JINA_API_KEY=jina_your_primary_api_key

# ── LangSmith Observability & Tracing ─────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key
LANGSMITH_PROJECT=srkr-academic-advisor
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Backend API Server (Optional Defaults) ────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
